{
  "name": "Ascension",
  "notes": "Harmonic series of an unsounded 36 Hz fundamental. Integer partials only; no scale, no temperament, no octave equivalence. Time unit tau = 2s, generated by the 0.5 Hz beating of the two detuned partial-16 voices in Phase I. Amplitude follows 1.8/n so the texture fuses rather than reading as a chord. Sines only, so every frequency in the air is a chosen one. Pan encodes prime factorisation: powers of 2 centre, 3-axis left, 5-axis right, 7-axis far edge, cross-prime products centre.",

  "fundamental": 36.0,
  "tau": 2.0,

  "voice": {
    "wave": "sine",
    "gainCoefficient": 1.8,
    "minAttack": 1.2
  },

  "keys": {
    "a": { "ratio": 1,     "label": "1/1  36.00 Hz" },
    "s": { "ratio": 1.125, "label": "9/8  40.50 Hz" },
    "d": { "ratio": 1.25,  "label": "5/4  45.00 Hz" },
    "f": { "ratio": 1.3333333333, "label": "4/3  48.00 Hz" },
    "g": { "ratio": 1.5,   "label": "3/2  54.00 Hz" },
    "h": { "ratio": 1.6666666667, "label": "5/3  60.00 Hz" },
    "j": { "ratio": 1.75,  "label": "7/4  63.00 Hz" },
    "k": { "ratio": 2,     "label": "2/1  72.00 Hz" }
  },

  "passage": {
    "duration": 28.5,

    "phases": [
      { "at": 0,  "label": "I. Undifferentiated", "gloss": "one element, and the difference that becomes time" },
      { "at": 4,  "label": "II. Differentiation", "gloss": "parts enter, each opening a new prime axis" },
      { "at": 10, "label": "III. Binding",        "gloss": "cross-prime products collapse the field to centre" },
      { "at": 16, "label": "IV. Self-reference",  "gloss": "difference tones regenerate the first voice" },
      { "at": 22, "label": "V. Missing fundamental", "gloss": "the self as inference; 36 Hz, never played" }
    ],

    "events": [
      { "at": 0,  "partial": 16, "dur": 10,  "pan": 0,     "attack": 2.5, "release": 4.0, "note": "origin voice" },
      { "at": 0,  "partial": 16, "dur": 10,  "pan": 0,     "attack": 2.5, "release": 4.0, "detune": 1.5, "note": "+1.5c -> 0.5 Hz beat -> tau" },

